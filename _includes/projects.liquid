<div class="col mb-4">
  <article class="vf-project-card">
    {% if project.img %}
      <a
        class="vf-project-image"
        href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"
        aria-label="Read {{ project.title }}"
      >
        {% include figure.liquid loading="lazy" path=project.img sizes="(min-width: 992px) 360px, (min-width: 576px) 50vw, 100vw" alt=project.image_alt class="card-img-top" %}
      </a>
    {% endif %}
    <div class="vf-project-card-body">
      <p class="vf-kicker">
        {{ project.focus }}
        {% if project.year %} · {{ project.year }}{% endif %}
      </p>
      <h2>{{ project.title }}</h2>
      <p>{{ project.description }}</p>
      {% if project.tags %}
        <ul class="vf-project-tags" aria-label="Technologies">
          {% for tag in project.tags %}
            <li>{{ tag }}</li>
          {% endfor %}
        </ul>
      {% endif %}
      <div class="vf-project-links">
        <a href="{{ project.url | relative_url }}">Case study →</a>
        {% if project.live %}
          <a href="{{ project.live }}">Live ↗</a>
        {% endif %}
        {% if project.paper %}
          <a href="{{ project.paper }}">Paper ↗</a>
        {% endif %}
        {% if project.huggingface %}
          <a href="{{ project.huggingface }}">Model ↗</a>
        {% endif %}
        {% if project.github %}
          <a href="{{ project.github }}">Code ↗</a>
        {% endif %}
      </div>
    </div>
  </article>
</div>
